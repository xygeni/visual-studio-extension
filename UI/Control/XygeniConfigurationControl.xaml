<UserControl x:Class="vs2026_plugin.UI.Control.XygeniConfigurationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d" 
             d:DesignHeight="420" d:DesignWidth="350">

    <UserControl.Resources>
        <!-- A pill switch for the Scan configuration rows, like the VS Code extension and the IntelliJ plugin (#415). -->
        <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="30" Height="16" Background="Transparent">
                            <Border x:Name="Track" CornerRadius="8" Background="#6B6B6B"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource {x:Static vsshell:EnvironmentColors.AccentMediumBrushKey}}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Track" Property="Opacity" Value="0.4"/>
                                <Setter TargetName="Knob" Property="Opacity" Value="0.6"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StyledButton" TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Image Source="media\icons\play.png" Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Text="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <TextBlock Text="Xygeni API URL" Margin="0,0,0,5" FontWeight="Bold"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <TextBox x:Name="ApiUrlTxt" Margin="0,0,0,10" Width="320" HorizontalAlignment="Left"/>

            <TextBlock Text="Xygeni API Token" Margin="0,0,0,5" FontWeight="Bold"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <PasswordBox x:Name="ApiTokenTxt" Margin="0,0,0,10" Width="320" HorizontalAlignment="Left"/>

            <Separator Margin="0,4,0,8"/>

            <Expander Header="Local Proxy Settings (Optional)"
                IsExpanded="False" Margin="0,0,0,12"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="Protocol (for example: http, https)" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="ProxyProtocolTxt" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left"/>

                    <TextBlock Text="Host" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="ProxyHostTxt" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left"/>

                    <TextBlock Text="Port" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="ProxyPortTxt" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left"/>

                    <TextBlock Text="Authentication" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="ProxyAuthenticationTxt" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left"/>

                    <TextBlock Text="Username" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="ProxyUsernameTxt" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left"/>

                    <TextBlock Text="Password" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <PasswordBox x:Name="ProxyPasswordTxt" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left"/>

                    <TextBlock Text="Non-proxy hosts (comma-separated)" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="ProxyNonProxyHostsTxt" Margin="0,0,0,0" Width="320" HorizontalAlignment="Left"/>
                </StackPanel>
            </Expander>

            <CheckBox x:Name="AutoScanChk"
                Content="Auto-run incremental scan on save"
                Margin="0,0,0,10"
                IsEnabled="False"
                Checked="AutoScanChk_Changed"
                Unchecked="AutoScanChk_Changed"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>

            <TextBlock x:Name="UpgradeMsg"
                Margin="0,0,0,10"
                Visibility="Collapsed"
                TextWrapping="Wrap"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}">
                <Run Text="Auto Scan on Save is not available on the Free plan. " />
                <Hyperlink Click="OpenUpgradeLink_Click">
                    <Run Text="Upgrade your plan" />
                </Hyperlink>
                <Run Text="." />
            </TextBlock>

            <!-- Scanner global options, placed before the command: xygeni <options> scan ... (xygeni/tech-support#378) -->
            <CheckBox x:Name="SkipSslVerifyChk"
                Content="Skip SSL verification (--skip-ssl-verify)"
                ToolTip="For corporate proxies that inspect TLS traffic. This reduces transport security: use it only in trusted networks."
                Margin="0,0,0,10"
                Click="SkipSslVerifyChk_Click"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>

            <Expander x:Name="ScannerOptionsExpander" Header="Scanner Options (Advanced)"
                IsExpanded="False" Margin="0,0,0,12"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}">
                <StackPanel Margin="0,6,0,0">
                    <CheckBox x:Name="SkipUpdateChk"
                        Content="Skip scanner update (--skip-update)"
                        ToolTip="Do not update the scanner before running it. You may run an outdated scanner version."
                        Margin="0,0,0,8"
                        Checked="ScannerOptionChk_Changed"
                        Unchecked="ScannerOptionChk_Changed"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <CheckBox x:Name="VerboseChk"
                        Content="Verbose scanner output (--verbose)"
                        Margin="0,0,0,8"
                        Checked="ScannerOptionChk_Changed"
                        Unchecked="ScannerOptionChk_Changed"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBlock Text="Additional global options" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="AdditionalGlobalOptionsTxt" Margin="0,0,0,3" Width="320" HorizontalAlignment="Left"
                        LostFocus="AdditionalGlobalOptionsTxt_LostFocus"/>
                    <TextBlock Width="320" HorizontalAlignment="Left" TextWrapping="Wrap" Opacity="0.8"
                        Text="Placed before the scanner command, separated by spaces (e.g. -cop key=value). Leave empty unless Xygeni support asks for it. -q/--quiet (the extension reads the scanner output) and --api-key (the token comes from this configuration) are ignored."
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                </StackPanel>
            </Expander>

            <!-- MCP server: shared install, version and updates (xygeni/xygeni-product-backlog#2382) -->
            <Expander x:Name="McpExpander" Header="MCP Server"
                IsExpanded="False" Margin="0,0,0,12"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="Installed in" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBox x:Name="McpPathTxt" Margin="0,0,0,8" Width="320" HorizontalAlignment="Left" IsReadOnly="True"/>
                    <TextBlock x:Name="McpStatusTxt" Width="320" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,8"
                        Text="not installed"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <!-- After an update: what to do, in the user's words, until they say OK (#2382) -->
                    <TextBlock x:Name="McpRestartNoteTxt" Width="320" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,4"
                        Foreground="#E54D4D" Visibility="Collapsed"/>
                    <WrapPanel x:Name="McpRestartButtons" Margin="0,0,0,8" Visibility="Collapsed">
                        <Button x:Name="McpRestartHowBtn" Content="Show me how" Width="100" Margin="0,0,10,0" Click="McpRestartHowBtn_Click"/>
                        <Button x:Name="McpRestartOkBtn" Content="OK" Width="50" Click="McpRestartOkBtn_Click"/>
                    </WrapPanel>
                    <Expander x:Name="McpRestartGuide" Header="How to restart your AI assistant" IsExpanded="False" Margin="0,0,0,8" Visibility="Collapsed"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}">
                        <StackPanel Margin="12,4,0,0">
                            <TextBlock Width="308" TextWrapping="Wrap" Margin="0,0,0,4" Text="An update only replaces the Xygeni MCP server file. The AI assistant that uses it keeps the old version loaded until it is restarted:"
                                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                            <TextBlock Width="308" TextWrapping="Wrap" Margin="0,0,0,2" Text="• GitHub Copilot in VS Code: Command Palette → MCP: List Servers → xygeni → Restart. Or reload the VS Code window."
                                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                            <TextBlock Width="308" TextWrapping="Wrap" Margin="0,0,0,2" Text="• Claude Code: type /mcp and reconnect xygeni. Or close Claude Code and open it again."
                                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                            <TextBlock Width="308" TextWrapping="Wrap" Margin="0,0,0,2" Text="• Cursor: Settings → MCP → switch xygeni off and on. Or restart Cursor."
                                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                            <TextBlock Width="308" TextWrapping="Wrap" Margin="0,0,0,2" Text="• Claude Desktop: quit the application and open it again."
                                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                            <TextBlock Width="308" TextWrapping="Wrap" Margin="0,0,0,4" Text="• Any other assistant: close it and open it again. Its Xygeni configuration does not change."
                                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                            <TextBlock Width="308" TextWrapping="Wrap" Opacity="0.8" Text="Not using an AI assistant with Xygeni yet? Nothing to do: the first start already loads the new version."
                                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                        </StackPanel>
                    </Expander>
                    <TextBlock Text="MCP server updates" Margin="0,0,0,3"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <ComboBox x:Name="McpUpdateModeCmb" Margin="0,0,0,3" Width="320" HorizontalAlignment="Left"
                        SelectionChanged="McpUpdateModeCmb_SelectionChanged">
                        <ComboBoxItem Content="Notify me" Tag="notify"/>
                        <ComboBoxItem Content="Update automatically" Tag="auto"/>
                        <ComboBoxItem Content="Off" Tag="off"/>
                    </ComboBox>
                    <TextBlock Width="320" HorizontalAlignment="Left" TextWrapping="Wrap" Opacity="0.8" Margin="0,0,0,8"
                        Text="The published version is checked once a day after the connection is validated. Notify me offers Update / Ignore this version; Update automatically installs it in the background. After an update, restart your AI assistant so it uses the new version."
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <WrapPanel>
                        <Button x:Name="CheckMcpUpdatesBtn" Content="Check for updates" Width="130" Margin="0,0,10,0" Click="CheckMcpUpdatesBtn_Click" IsEnabled="False"/>
                        <Button x:Name="CopyMcpConfigBtn" Content="Copy MCP config (JSON)" Width="160" Click="CopyMcpConfigBtn_Click" IsEnabled="False"/>
                    </WrapPanel>
                </StackPanel>
            </Expander>

            <!-- Per-project scan configuration: which scan types run, full and on save (xygeni/xygeni-product-backlog#415) -->
            <Expander x:Name="ScanConfigExpander" Header="Scan configuration"
                IsExpanded="False" Margin="0,0,0,12" Expanded="ScanConfigExpander_Expanded"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock x:Name="ScanConfigProjectTxt" Width="320" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,0,0,6" Opacity="0.8"
                        Text="Open a solution or folder to configure its scan."
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <WrapPanel Margin="0,0,0,6">
                        <Button x:Name="SelectAllScanTypesBtn" Content="Select all" Width="80" Margin="0,0,6,0" Click="SelectAllScanTypesBtn_Click"/>
                        <Button x:Name="ClearScanTypesBtn" Content="Clear" Width="60" Margin="0,0,6,0" Click="ClearScanTypesBtn_Click"/>
                        <Button x:Name="RestoreScanDefaultsBtn" Content="Restore defaults" Width="110" Margin="0,0,6,0" Click="RestoreScanDefaultsBtn_Click"/>
                        <Button x:Name="OpenScanConfigBtn" Content="Open file" Width="70" Click="OpenScanConfigBtn_Click"/>
                    </WrapPanel>
                    <Grid x:Name="ScanConfigRows" Width="330" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="64"/>
                        </Grid.ColumnDefinitions>
                    </Grid>
                    <TextBlock Text="Excluded folders" Margin="0,10,0,3"
                        ToolTip="Folders and patterns excluded from every scan, added to the scanner defaults (node_modules, target, dist…). Glob patterns: * file wildcard, ** any depth, &quot;path:&quot; prefix for a sub-project. Needs scanner 6.23 or later."
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <ListBox x:Name="ExcludesList" Width="320" Height="64" HorizontalAlignment="Left" Margin="0,0,0,4"
                        SelectionChanged="ExcludesList_SelectionChanged"/>
                    <WrapPanel Margin="0,0,0,4">
                        <TextBox x:Name="ExcludePatternTxt" Width="180" Margin="0,0,6,0" ToolTip="A glob pattern, e.g. **/fixtures/**"/>
                        <Button x:Name="AddExcludePatternBtn" Content="Add" Width="50" Margin="0,0,6,0" Click="AddExcludePatternBtn_Click"/>
                        <Button x:Name="AddExcludeFolderBtn" Content="Add folder…" Width="90" Margin="0,0,6,0" Click="AddExcludeFolderBtn_Click"/>
                        <Button x:Name="RemoveExcludeBtn" Content="Remove" Width="60" Click="RemoveExcludeBtn_Click" IsEnabled="False"/>
                    </WrapPanel>
                    <!-- Scanner options (#415): a command-line-like field with autocompletion and validation; only the options
                         in ScanOptions.Specs are accepted, the ones the extension sets itself are refused with the reason. -->
                    <TextBlock Text="Scanner options" Margin="0,10,0,3"
                        ToolTip="Options passed to xygeni scan in the full scan and on save. Type -- to see the ones the IDE can pass; the options the extension sets itself (--run, -o, excludes…) are refused."
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <ListBox x:Name="OptionsList" Width="320" Height="64" HorizontalAlignment="Left" Margin="0,0,0,4"
                        SelectionChanged="OptionsList_SelectionChanged"/>
                    <Grid Width="320" HorizontalAlignment="Left" Margin="0,0,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="OptionTxt" Grid.Column="0" Margin="0,0,6,0" ToolTip="--option=value  (type -- to see them)"
                            TextChanged="OptionTxt_TextChanged" PreviewKeyDown="OptionTxt_PreviewKeyDown" LostKeyboardFocus="OptionTxt_LostKeyboardFocus"/>
                        <Popup x:Name="OptionPopup" PlacementTarget="{Binding ElementName=OptionTxt}" Placement="Bottom" StaysOpen="True"
                            Width="{Binding ActualWidth, ElementName=OptionTxt}">
                            <ListBox x:Name="OptionSuggestions" MaxHeight="160" PreviewMouseLeftButtonUp="OptionSuggestions_PreviewMouseLeftButtonUp"/>
                        </Popup>
                        <Button x:Name="AddOptionBtn" Grid.Column="1" Content="Add" Width="50" Margin="0,0,6,0" Click="AddOptionBtn_Click" IsEnabled="False"/>
                        <Button x:Name="RemoveOptionBtn" Grid.Column="2" Content="Remove" Width="60" Click="RemoveOptionBtn_Click" IsEnabled="False"/>
                    </Grid>
                    <TextBlock x:Name="OptionHintTxt" Width="320" HorizontalAlignment="Left" TextWrapping="Wrap" Opacity="0.8" Text=" " Margin="0,0,0,4"
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                    <TextBlock Width="320" HorizontalAlignment="Left" TextWrapping="Wrap" Opacity="0.8" Margin="0,6,0,0"
                        Text="Full scan: the scan types of Run Scan (SCA brings suspect dependencies; at least one is required). On save: only the scan types that can analyze just the changed files are offered, and a type must be in the full scan to run on save. Saved in .xygeni\ide.json at the project root, shared with the other Xygeni IDE plugins: commit it to share it with your team."
                        Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                </StackPanel>
            </Expander>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Xygeni Scanner Status: "
                    Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <TextBlock x:Name="StatusTxt" Padding="5 1 5 1" FontWeight="Bold" Text="not installed"
                    Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            </StackPanel>

            <WrapPanel Margin="0,0,0,10">
                <Button x:Name="SaveBtn" Content="Save &amp; Install" Width="120" Margin="0,0,10,0" Click="SaveBtn_Click" />
                <Button Style="{StaticResource StyledButton}" x:Name="RunScanBtn" Content="Run Scan" Width="120" Click="RunScanBtn_Click" Margin="0,0,10,0" IsEnabled="False"/>
                <Button x:Name="OpenXygeniExplorerBtn" Content="Open Xygeni Explorer" Width="130" Margin="0,0,10,0" Click="OpenXygeniExplorerBtn_Click" IsEnabled="True"/>
            </WrapPanel>

            <TextBlock x:Name="OpenOutputBtn"
                Foreground="{DynamicResource {x:Static vsshell:EnvironmentColors.ToolWindowTextBrushKey}}">
                <Run Text="Open " />
                <Hyperlink Click="OpenOutputBtn_Click">
                    <Run Text="Output Window" />
                </Hyperlink>
                <Run Text=" to see the Xygeni operations output" />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
